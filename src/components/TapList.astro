---
// TapList — fetches current beer tap list from live API
import { t } from '@i18n/utils';

const locale = Astro.currentLocale || 'th';
const tagBase = `/${locale === 'th' ? 'th/' : ''}tag/`;
const apiUrl = import.meta.env.DEV
  ? '/pos-api/taplist'
  : 'https://pos-api.opencraft.bar/api/taplist';
const strings = {
  updated: t('tapList.updated', locale),
  onTap: t('tapList.onTap', locale),
  loading: locale === 'th' ? 'กำลังโหลด...' : 'Loading...',
  error:
    locale === 'th'
      ? 'ไม่สามารถโหลดรายการเบียร์ได้ในขณะนี้'
      : 'Unable to load tap list. Please try again later.',
};

// Asahi is a permanent tap — always displayed as featured
const asahi = {
  labelName: 'Super Dry',
  brewery: 'Asahi',
  style: 'Japanese Rice Lager',
  abv: 5.0,
  prices: [
    { size: 'Glass', price: 99 },
    { size: 'Pitcher', price: 285 },
    { size: 'Tower', price: 790 },
  ],
};
---

<section
  id="tap-list"
  class="py-20 theme-transition"
  style="background-color: var(--color-bg-primary);"
  data-api-url={apiUrl}
  data-tag-base={tagBase}
  data-updated-label={strings.updated}
  data-on-tap-label={strings.onTap}
  data-error-label={strings.error}
>
  <div class="container-main">
    <!-- Section heading -->
    <div class="text-center mb-12 animate-on-scroll">
      <h2 class="section-heading">
        🍺 {t('tapList.heading', locale)}
      </h2>
      <p class="section-subheading">
        {t('tapList.subheading', locale)}
      </p>
    </div>

    <!-- Featured beer (Asahi) — permanent tap, distinct full-width banner card -->
    <div class="mb-10 animate-on-scroll">
      <div class="relative overflow-hidden rounded-2xl" style="background: linear-gradient(135deg, var(--color-bg-secondary) 0%, var(--color-bg-primary) 100%); border: 2px solid var(--color-accent); box-shadow: 0 20px 50px -20px var(--color-accent-glow);">
        <!-- Accent glow strip -->
        <div class="absolute top-0 left-0 right-0 h-1.5" style="background: linear-gradient(90deg, transparent, var(--color-accent), transparent);"></div>

        <div class="grid grid-cols-1 md:grid-cols-5 gap-0">
          <!-- Left: Beer identity -->
          <div class="md:col-span-2 p-8 flex flex-col justify-center" style="border-right: 1px solid var(--color-border);">
            <div class="flex items-center gap-3 mb-4">
              <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider" style="background-color: var(--color-accent); color: var(--color-bg-primary);">
                ★ Featured
              </span>
              <span class="text-xs font-mono" style="color: var(--color-text-muted);">
                {asahi.abv}% ABV
              </span>
            </div>
            <h3 class="text-3xl md:text-4xl font-black leading-none mb-2" style="color: var(--color-text-heading);">
              {asahi.labelName}
            </h3>
            <p class="text-lg font-medium mb-1" style="color: var(--color-accent);">
              {asahi.brewery}
            </p>
            <a href={`${tagBase}${encodeURIComponent(asahi.style)}/`} class="text-sm transition-colors" style="color: var(--color-text-secondary);">
              {asahi.style} ↗
            </a>
          </div>

          <!-- Right: Pricing tiers -->
          <div class="md:col-span-3 p-8 grid grid-cols-3 gap-4 items-center">
            {asahi.prices.map((p, i) => (
              <div class={`text-center ${i < asahi.prices.length - 1 ? 'md:border-r' : ''}`} style={i < asahi.prices.length - 1 ? { borderColor: 'var(--color-border)' } : {}}>
                <div class="text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-muted);">
                  {p.size}
                </div>
                <div class="text-3xl md:text-4xl font-black font-mono leading-none" style="color: var(--color-accent);">
                  ฿{p.price}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Loading state -->
    <div id="tap-list-loading" class="text-center py-12">
      <p class="text-lg" style="color: var(--color-text-muted);">{strings.loading}</p>
    </div>

    <!-- Tap cards grid — hidden until API data loads -->
    <div
      id="tap-list-grid"
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 stagger-children animate-on-scroll"
      style="display: none;"
    ></div>

    <!-- Updated info -->
    <p id="tap-list-meta" class="text-center mt-8 text-sm" style="color: var(--color-text-muted); display: none;"></p>
  </div>
</section>

<script>
  import { buildTapList } from '../scripts/taplist-parser.js';

  type TapSize = { label: string; price: number | null };
  type TapBeer = {
    key: string;
    tapNumber: number;
    brewery: string;
    labelName: string;
    abv: number | null;
    styles: string[];
    currency: string;
    sizes: TapSize[];
  };

  const root = document.getElementById('tap-list');

  if (root) {
    const apiUrl = root.dataset.apiUrl || '/api/taplist';
    const tagBase = root.dataset.tagBase || '/tag/';
    const strings = {
      updated: root.dataset.updatedLabel || '',
      onTap: root.dataset.onTapLabel || '',
      error: root.dataset.errorLabel || '',
    };

    const loadingEl = document.getElementById('tap-list-loading')!;
    const gridEl = document.getElementById('tap-list-grid')!;
    const metaEl = document.getElementById('tap-list-meta')!;

    const esc = (str: string | number) =>
      String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');

    const trimNumber = (value: number | string) => String(Math.round(Number(value) * 100) / 100);

    const formatPrice = (price: number | null, currency: string) => {
      if (price === null || price === undefined) return '—';
      const amount = Number(price);
      if (!Number.isFinite(amount)) return '—';
      const formatted = trimNumber(amount);
      return currency && currency !== 'THB' ? `${esc(currency)} ${formatted}` : `฿${formatted}`;
    };

    const renderCard = (beer: TapBeer) => {
      const num = String(beer.tapNumber || 0).padStart(2, '0');

      const abvHtml =
        beer.abv !== null && Number.isFinite(Number(beer.abv))
          ? `<span class="text-sm font-mono font-bold px-2.5 py-1 rounded-full"
              style="background-color: var(--color-bg-secondary); color: var(--color-text-heading);"
            >${esc(trimNumber(beer.abv))}% ABV</span>`
          : '';

      const breweryHtml = beer.brewery
        ? `<p class="text-sm mb-3" style="color: var(--color-text-secondary);">${esc(beer.brewery)}</p>`
        : '';

      const styleHtml = beer.styles.length
        ? `<div class="flex flex-wrap gap-1.5 mb-4">${beer.styles
            .map(
              (style: string) => `<a href="${tagBase}${encodeURIComponent(style)}/"
                class="px-2.5 py-1 rounded-full text-xs font-medium transition-colors"
                style="background-color: var(--color-accent-glow); color: var(--color-accent);"
              >${esc(style)}</a>`
            )
            .join('')}</div>`
        : '';

      const sizesHtml = beer.sizes.length
        ? `<div class="grid gap-1 text-center" style="grid-template-columns: repeat(${beer.sizes.length}, minmax(0, 1fr));">
            ${beer.sizes
              .map(
                (size: TapSize) => `<div>
                    <div class="text-xs font-semibold tracking-wider mb-0.5" style="color: var(--color-text-muted);">
                      ${size.label ? esc(size.label) : '&nbsp;'}
                    </div>
                    <div class="font-mono font-bold" style="color: var(--color-accent);">${formatPrice(size.price, beer.currency)}</div>
                  </div>`
              )
              .join('')}
          </div>`
        : '';

      return `<article class="card flex flex-col">
        <div class="flex items-start justify-between gap-2 mb-3">
          <span class="text-3xl font-black leading-none" style="color: var(--color-accent);">${esc(num)}</span>
          ${abvHtml}
        </div>
        <h3 class="font-bold text-xl leading-tight mb-1" style="color: var(--color-text-heading);">${esc(beer.labelName)}</h3>
        ${breweryHtml}
        ${styleHtml}
        <div class="mt-auto pt-3 border-t" style="border-color: var(--color-border);">
          ${sizesHtml}
        </div>
      </article>`;
    };

    const loadTapList = async () => {
      try {
        const res = await fetch(apiUrl, {
          headers: { Accept: 'application/json, text/plain;q=0.9' },
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        const text = await res.text();

        let payload;
        try {
          payload = JSON.parse(text);
        } catch {
          // A plain-text BLF document is a valid tap list response too.
          payload = text;
        }

        const beers = buildTapList(payload, text) as TapBeer[];
        if (beers.length === 0) throw new Error('No items');

        gridEl.innerHTML = beers.map(renderCard).join('');
        gridEl.style.display = '';

        const payloadMeta = payload as { cachedAt?: unknown } | null;
        const cachedAt =
          payloadMeta && typeof payloadMeta.cachedAt === 'string'
            ? new Date(payloadMeta.cachedAt)
            : new Date();
        const date = Number.isNaN(cachedAt.getTime())
          ? new Date().toISOString().slice(0, 10)
          : cachedAt.toISOString().slice(0, 10);

        metaEl.textContent = `📋 ${strings.updated}: ${date} — ${beers.length} ${strings.onTap}`;
        metaEl.style.display = '';

        loadingEl.style.display = 'none';
      } catch (_) {
        loadingEl.innerHTML = `<p style="color: var(--color-text-muted);">${strings.error}</p>`;
      }
    };

    loadTapList();
  }
</script>
