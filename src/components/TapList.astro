---
// TapList — fetches current beer tap list from live API
import { t } from '@i18n/utils';

const locale = Astro.currentLocale || 'th';
const tagBase = `/${locale === 'th' ? 'th/' : ''}tag/`;
const strings = {
  updated: t('tapList.updated', locale),
  onTap: t('tapList.onTap', locale),
  loading: locale === 'th' ? 'กำลังโหลด...' : 'Loading...',
  error:
    locale === 'th'
      ? 'ไม่สามารถโหลดรายการเบียร์ได้ในขณะนี้'
      : 'Unable to load tap list. Please try again later.',
};
---

<section id="tap-list" class="py-20 theme-transition" style="background-color: var(--color-bg-primary);">
  <div class="container-main">
    <!-- Section heading -->
    <div class="text-center mb-12 animate-on-scroll">
      <h2 class="section-heading">
        🍺 {t('tapList.heading', locale)}
      </h2>
      <p class="section-subheading">
        {t('tapList.subheading', locale)}
      </p>
    </div>

    <!-- Loading state -->
    <div id="tap-list-loading" class="text-center py-12">
      <p class="text-lg" style="color: var(--color-text-muted);">{strings.loading}</p>
    </div>

    <!-- Tap cards grid — hidden until API data loads -->
    <div
      id="tap-list-grid"
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 stagger-children animate-on-scroll"
      style="display: none;"
    ></div>

    <!-- Updated info -->
    <p id="tap-list-meta" class="text-center mt-8 text-sm" style="color: var(--color-text-muted); display: none;"></p>
  </div>
</section>

<script define:vars={{ tagBase, strings }}>
  async function loadTapList() {
    const loadingEl = document.getElementById('tap-list-loading');
    const gridEl = document.getElementById('tap-list-grid');
    const metaEl = document.getElementById('tap-list-meta');

    try {
      const res = await fetch('https://pos-api.opencraft.bar/api/taplist');
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();

      const beers = processTapList(data.items || []);
      if (beers.length === 0) throw new Error('No items');

      gridEl.innerHTML = beers.map(renderCard).join('');
      gridEl.style.display = '';

      const date = data.cachedAt
        ? new Date(data.cachedAt).toISOString().slice(0, 10)
        : new Date().toISOString().slice(0, 10);
      metaEl.textContent = `📋 ${strings.updated}: ${date} — ${beers.length} ${strings.onTap}`;
      metaEl.style.display = '';

      loadingEl.style.display = 'none';
    } catch (_) {
      loadingEl.innerHTML = `<p style="color: var(--color-text-muted);">${strings.error}</p>`;
    }
  }

  /**
   * Group raw API items by unique beer (split name on ']'), extract metadata,
   * and collect size/price options per beer.
   */
  function processTapList(items) {
    const beers = new Map();

    for (const item of items) {
      const bracketStart = item.name.indexOf('[');
      const bracketEnd = item.name.indexOf(']');
      if (bracketStart === -1 || bracketEnd === -1) continue;

      // "1. [S] Paulaner Hefe-Weissbier 5.5%" → sizeLabel="S", beerKey="Paulaner Hefe-Weissbier 5.5%"
      const sizeLabel = item.name.slice(bracketStart + 1, bracketEnd);
      const beerKey = item.name.slice(bracketEnd + 1).trim();
      const tapNumber = parseInt(item.name.split('.')[0].trim(), 10) || 0;

      if (!beers.has(beerKey)) {
        const tags = item.tags || [];

        // First tag is always the brewery name
        const brewery = tags[0] || '';

        // ABV tag: e.g. "5.5%"
        const abvTag = tags.find((tag) => /^\d+\.?\d*%$/.test(tag)) || '';
        const abv = parseFloat(abvTag) || 0;

        // Style: prefer tags with "Style: " prefix, otherwise use first
        // non-brewery / non-abv / non-volume / non-draft tag
        const styleTags = tags
          .filter((tag) => tag.startsWith('Style: '))
          .map((tag) => tag.replace('Style: ', ''));
        const style =
          styleTags.length > 0
            ? styleTags[0]
            : tags.find(
                (tag) =>
                  tag !== brewery &&
                  !/^\d+\.?\d*%$/.test(tag) &&
                  !/^\d+ml$/.test(tag) &&
                  tag !== 'Draft' &&
                  !tag.startsWith('Style: ')
              ) || '';

        // Strip brewery prefix and ABV suffix to get a clean label name
        let labelName = beerKey;
        if (brewery && labelName.startsWith(brewery)) {
          labelName = labelName.slice(brewery.length).trim();
        }
        if (abvTag && labelName.endsWith(abvTag)) {
          labelName = labelName.slice(0, -abvTag.length).trim();
        }

        beers.set(beerKey, { tapNumber, brewery, labelName, abv, style, sizes: [] });
      }

      // Volume from tags: e.g. "250ml", "500ml"
      const mlTag = (item.tags || []).find((tag) => /^\d+ml$/.test(tag)) || '';
      beers.get(beerKey).sizes.push({ sizeLabel, volume: mlTag, price: item.price });
    }

    return Array.from(beers.values()).sort((a, b) => a.tapNumber - b.tapNumber);
  }

  function esc(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function renderCard(beer) {
    const num = String(beer.tapNumber).padStart(2, '0');

    const styleLink = beer.style
      ? `<a href="${tagBase}${encodeURIComponent(beer.style)}/"
            class="self-start px-2.5 py-1 rounded-full text-xs font-medium mb-4 transition-colors"
            style="background-color: var(--color-accent-glow); color: var(--color-accent);"
          >${esc(beer.style)}</a>`
      : '';

    const sizesHtml =
      beer.sizes.length > 0
        ? `<div class="grid gap-1 text-center" style="grid-template-columns: repeat(${beer.sizes.length}, 1fr);">
            ${beer.sizes
              .map(
                (s) =>
                  `<div>
                    <div class="text-xs font-semibold tracking-wider mb-0.5" style="color: var(--color-text-muted);">
                      ${esc(s.sizeLabel)}${s.volume ? ` · ${esc(s.volume)}` : ''}
                    </div>
                    <div class="font-mono font-bold" style="color: var(--color-accent);">฿${s.price}</div>
                  </div>`
              )
              .join('')}
          </div>`
        : '';

    return `<article class="card flex flex-col">
      <div class="flex items-start justify-between mb-3">
        <span class="text-3xl font-black leading-none" style="color: var(--color-accent);">${esc(num)}</span>
        <span class="text-sm font-mono font-bold px-2.5 py-1 rounded-full"
          style="background-color: var(--color-bg-secondary); color: var(--color-text-heading);"
        >${esc(beer.abv)}% ABV</span>
      </div>
      <h3 class="font-bold text-xl leading-tight mb-1" style="color: var(--color-text-heading);">${esc(beer.labelName)}</h3>
      <p class="text-sm mb-3" style="color: var(--color-text-secondary);">${esc(beer.brewery)}</p>
      ${styleLink}
      <div class="mt-auto pt-3 border-t" style="border-color: var(--color-border);">
        ${sizesHtml}
      </div>
    </article>`;
  }

  loadTapList();
</script>
