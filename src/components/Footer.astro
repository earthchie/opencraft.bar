---
// Footer component
import Logo from './Logo.astro';
import OfficialLinkIcon from './OfficialLinkIcon.astro';
import { officialLinks } from '@data/officialLinks';
import { t } from '@i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = Astro.currentLocale || 'th';
const homeUrl = getRelativeLocaleUrl(locale, '');

const quickLinks = [
  { key: 'nav.home', href: getRelativeLocaleUrl(locale, '') },
  { key: 'nav.news', href: getRelativeLocaleUrl(locale, 'news') },
  { key: 'nav.knowledge', href: getRelativeLocaleUrl(locale, 'knowledge') },
  { key: 'nav.location', href: getRelativeLocaleUrl(locale, 'location') },
  { key: 'nav.services', href: getRelativeLocaleUrl(locale, 'services') },
  { key: 'nav.standard', href: getRelativeLocaleUrl(locale, 'standard') },
  { key: 'nav.about', href: getRelativeLocaleUrl(locale, 'about') },
];
---

<footer class="theme-transition" style="background-color: var(--color-bg-footer); color: var(--color-text-secondary);">
  <div class="container-main py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div>
        <a href={homeUrl} class="flex items-center gap-2 mb-3">
          <Logo variant="icon" size="sm" className="brightness-0 invert" />
          <Logo variant="wordmark" size="sm" className="brightness-0 invert" />
        </a>
        <p class="text-sm leading-relaxed opacity-80" style="color: var(--color-text-muted);">
          {t('footer.tagline', locale)}
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-sm font-semibold mb-3 uppercase tracking-wider" style="color: var(--color-accent);">
          {t('footer.quickLinks', locale)}
        </h3>
        <ul class="space-y-2">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm opacity-80 hover:opacity-100 transition-opacity" style="color: var(--color-text-muted);">
                {t(link.key, locale)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Official links -->
      <div>
        <h3 class="text-sm font-semibold mb-3 uppercase tracking-wider" style="color: var(--color-accent);">
          {t('footer.links', locale)}
        </h3>
        <ul class="space-y-2.5">
          {officialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                class="inline-flex items-center gap-2.5 text-sm opacity-80 hover:opacity-100 transition-opacity"
                style="color: var(--color-text-muted);"
              >
                <span class="w-7 h-7 rounded-full flex items-center justify-center flex-shrink-0" style="background-color: var(--color-bg-secondary);">
                  <OfficialLinkIcon name={link.icon} class="w-3.5 h-3.5" />
                </span>
                <span>{t(link.key, locale)}</span>
              </a>
            </li>
          ))}
        </ul>
        <a
          href={getRelativeLocaleUrl(locale, 'links')}
          class="inline-flex items-center gap-1.5 mt-4 text-sm font-medium transition-opacity hover:opacity-80"
          style="color: var(--color-accent);"
        >
          {t('footer.allLinks', locale)}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <!-- Bottom -->
    <div class="mt-10 pt-6 border-t text-center text-xs" style="border-color: rgba(255,255,255,0.1); color: var(--color-text-muted);">
      <p>{t('footer.copyright', locale)}</p>
      <p class="mt-1 opacity-60">{t('footer.craftedWith', locale)}</p>
    </div>
  </div>
</footer>
